#encoding UTF-8
## +-------------------------------------------------------------------------+
## |    gallery.html.tmpl                Template file for "gallery" page    |
## +-------------------------------------------------------------------------+

<!DOCTYPE html>
<html lang="$Extras.language">
<head>
  <title>
    $Extras.Translations[$Extras.language].gallery | $station.location
  </title>
  #include "head.inc"
  <link rel="stylesheet" href="css/aurora.css?v=$aurora.asset_version">
</head>
<body class="${Extras.Appearance.mode}-theme main-bg" ontouchstart="">

#attr $active_nav = 'gallery'
#include "header.inc"

<main data-aurora-page="gallery">
  <div class="container-fluid d-flex-xxl">

  #if not $aurora.enabled
    <div class="row my-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body text-center py-5">
            <h5 class="card-title">$Extras.Translations[$Extras.language].gallery</h5>
            <p class="card-text mb-0">
              Aurora section is disabled. Set <code>cam_dir</code> under
              <code>[Extras][[Aurora]]</code> to enable it.
            </p>
          </div>
        </div>
      </div>
    </div>
  #else
    #if $aurora.latest or $aurora.days
    #set $day = $aurora.latest if $aurora.latest else $aurora.days[0]
    <div class="row my-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Latest
              <small class="text-muted ml-2">$day.date_iso</small>
            </h5>
            <div class="row">
              <div class="col-md-4 mb-3">
                <h6 class="aurora-media-title">Night timelapse
                  #if $day.aurora_video and $day.aurora_pending
                  <span class="text-muted aurora-update-pending">(update pending)</span>
                  #end if
                </h6>
                #if $day.aurora_video
                <div class="aurora-media-frame">
                  #if $day.aurora_thumbnail
                  <img src="$day.aurora_thumbnail?v=$day.aurora_thumbnail_mtime"
                       alt="Night timelapse for $day.day_name" loading="lazy"
                       class="aurora-modal-trigger" data-type="video"
                       data-src="$day.aurora_video?v=$day.aurora_mtime"
                       data-title="Night timelapse — $day.day_name, $day.date_iso">
                  #else
                  <img src="$day.aurora_video?v=$day.aurora_mtime#t=0.5"
                       alt="Night timelapse for $day.day_name" loading="lazy"
                       class="aurora-modal-trigger" data-type="video"
                       data-src="$day.aurora_video?v=$day.aurora_mtime"
                       data-title="Night timelapse — $day.day_name, $day.date_iso">
                  #end if
                  <div class="aurora-play-overlay">&#9654;</div>
                </div>
                <small class="text-muted">$day.aurora_size_mb MB</small>
                #else
                <div class="aurora-placeholder d-flex align-items-center justify-content-center">
                  <span class="text-muted">Still encoding</span>
                </div>
                #end if
              </div>
              <div class="col-md-4 mb-3">
                <h6 class="aurora-media-title">Day timelapse
                  #if $day.cloud_video and $day.cloud_pending
                  <span class="text-muted aurora-update-pending">(update pending)</span>
                  #end if
                </h6>
                #if $day.cloud_video
                <div class="aurora-media-frame">
                  #if $day.cloud_thumbnail
                  <img src="$day.cloud_thumbnail?v=$day.cloud_thumbnail_mtime"
                       alt="Day timelapse for $day.day_name" loading="lazy"
                       class="aurora-modal-trigger" data-type="video"
                       data-src="$day.cloud_video?v=$day.cloud_mtime"
                       data-title="Day timelapse — $day.day_name, $day.date_iso">
                  #else
                  <img src="$day.cloud_video?v=$day.cloud_mtime#t=0.5"
                       alt="Day timelapse for $day.day_name" loading="lazy"
                       class="aurora-modal-trigger" data-type="video"
                       data-src="$day.cloud_video?v=$day.cloud_mtime"
                       data-title="Day timelapse — $day.day_name, $day.date_iso">
                  #end if
                  <div class="aurora-play-overlay">&#9654;</div>
                </div>
                <small class="text-muted">$day.cloud_size_mb MB</small>
                #else
                <div class="aurora-placeholder d-flex align-items-center justify-content-center">
                  <span class="text-muted">Still encoding</span>
                </div>
                #end if
              </div>
              #if $day.spaceweather
              <div class="col-md-4 mb-3">
                <h6 class="aurora-media-title">Space weather
                  #if $day.spaceweather_pending
                  <span class="text-muted aurora-update-pending">(update pending)</span>
                  #end if
                </h6>
                <div class="aurora-media-frame">
                  <img src="$day.spaceweather?v=$day.spaceweather_mtime"
                       alt="Kp history for $day.day_name" loading="lazy"
                       class="aurora-modal-trigger" data-type="image"
                       data-src="$day.spaceweather?v=$day.spaceweather_mtime"
                       data-title="Space weather history — $day.day_name, $day.date_iso">
                </div>
                <small class="text-muted">$day.spaceweather_size_kb kB</small>
              </div>
              #end if
            </div>
          </div>
        </div>
      </div>
    </div>
    #end if

    <div class="row my-4">
      <div class="col-12">
        <h3 class="h5-responsive $Extras.color-text">Nightly archive
          <small class="text-muted ml-2">$aurora.calendar.range_pretty</small></h3>
        #if not $aurora.calendar.enabled or $aurora.calendar.error
        <div class="card">
          <div class="card-body text-center py-5 text-muted">
            Archive calendar not available.
          </div>
        </div>
        #else
        <div class="tl-legend">
          #for $band in $aurora.calendar.kp_scale
          <span class="tl-legend-item"><span
              class="tl-swatch $band.css"></span>$band.label</span>
          #end for
        </div>
        <div class="tl-calendar">
          #for $wd in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
          <div class="tl-weekday">$wd</div>
          #end for
          #for $week in $aurora.calendar.weeks
          #for $cell in $week
          #if not $cell
          <div class="tl-cell tl-cell-empty"></div>
          #else
          #if not $cell.in_window
          ## Placeholder day outside the archive window (before it starts
          ## or after today): date-only box, shaded very dark grey.
          <div class="tl-cell tl-cell-out $cell.month_class"><span
              class="tl-date">$cell.day_of_month</span></div>
          #else
          #if $cell.aurora_video
          <button type="button"
                  class="tl-cell aurora-modal-trigger $cell.month_class ${'tl-cell-today' if $cell.is_today else ''}"
                  data-type="video"
                  data-src="$cell.aurora_video?v=$cell.aurora_mtime"
                  data-title="Night timelapse — $cell.day_name, $cell.date_iso">
          #else
          <div class="tl-cell $cell.month_class ${'tl-cell-today' if $cell.is_today else ''}">
          #end if
            <span class="tl-date">$cell.day_of_month</span>
            #if $cell.aurora_thumbnail
            <img class="tl-cell-img"
                 src="$cell.aurora_thumbnail?v=$cell.aurora_mtime"
                 alt="Night timelapse for $cell.date_iso" loading="lazy">
            #end if
            #if $cell.kp_text
            <span class="tl-kp $cell.kp_css">Kp $cell.kp_text</span>
            #else
            <span class="tl-kp-none">&#8211;</span>
            #end if
          #if $cell.aurora_video
          </button>
          #else
          </div>
          #end if
          #end if
          #end if
          #end for
          #end for
        </div>
        #end if
      </div>
    </div>

    #if not $aurora.days and (not $aurora.calendar.enabled or $aurora.calendar.error)
    <div class="row my-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body text-center py-5 text-muted">
            No timelapses found yet.
          </div>
        </div>
      </div>
    </div>
    #end if
  #end if

  </div>
</main>

<div id="auroraModal" class="aurora-modal" aria-hidden="true" role="dialog"
     aria-label="Media viewer">
  <span class="aurora-modal-close" aria-label="Close">&times;</span>
  <figure class="aurora-modal-dialog">
    <div class="aurora-modal-body"></div>
    <figcaption class="aurora-modal-caption"></figcaption>
  </figure>
</div>

#include "footer.inc"
#include "js.inc"
<script src="js/aurora-gallery.js?v=$aurora.asset_version"></script>

</body>
</html>
