#encoding UTF-8
## +-------------------------------------------------------------------------+
## |    aurora.html.tmpl                 Template file for "aurora" page     |
## +-------------------------------------------------------------------------+

<!DOCTYPE html>
<html lang="$Extras.language">
<head>
  <title>
    $Extras.Translations[$Extras.language].aurora | $station.location
  </title>
  #include "head.inc"
  <link rel="stylesheet" href="css/aurora.css?v=$aurora.asset_version">
</head>
<body class="${Extras.Appearance.mode}-theme main-bg" ontouchstart="">

#attr $active_nav = 'aurora'
#include "header.inc"

<main data-aurora-page="aurora">
  <div class="container-fluid d-flex-xxl">

  #if not $aurora.enabled
    <div class="row my-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body text-center py-5">
            <h5 class="card-title">$Extras.Translations[$Extras.language].aurora</h5>
            <p class="card-text mb-0">
              Viewing section is disabled. Set <code>cam_dir</code> under
              <code>[Extras][[Aurora]]</code> to enable it.
            </p>
          </div>
        </div>
      </div>
    </div>
  #else

    <script type="application/json" id="aurora-config">
    {
      "page": "aurora",
      "kpUrl": "$Extras.Aurora.kp_url",
      "windUrl": "$Extras.Aurora.wind_url",
      "magUrl": "$Extras.Aurora.mag_url",
      "noaaRefreshSeconds": $int($Extras.Aurora.noaa_refresh_seconds),
      "snapshotRefreshSeconds": $int($Extras.Aurora.snapshot_refresh_seconds),
      "cameras": [
        #set $sep = ""
        #for $cam in $aurora.cameras
        $sep{"key": "$cam.key", "url": "$cam.url"}#set $sep = ", "
        #end for
      ]
    }
    </script>

    ## Cameras: sky + ground side by side, half width each; click for full size
    <div class="row my-4">
      #for $cam in $aurora.cameras
      <div class="col-12 col-md-6 mb-3">
        <div class="card aurora-hero">
          #if $cam.exists
          <img src="$cam.url?v=$cam.mtime"
               class="aurora-hero-img aurora-modal-trigger"
               alt="$cam.label" data-snapshot-url="$cam.url"
               data-camera-key="$cam.key" data-type="image"
               data-src="$cam.url?v=$cam.mtime"
               data-title="$cam.label &mdash; full size">
          #else
          <div class="aurora-placeholder d-flex align-items-center justify-content-center">
            <span class="text-muted">No image from the $cam.label.lower() yet</span>
          </div>
          #end if
          <div class="aurora-hero-overlay">
            <span class="mr-2 font-weight-bold text-white-50">$cam.label</span>
            #if $cam.exists and not $cam.is_stale
            <span class="badge badge-danger live-badge">Live</span>
            #elif $cam.exists
            <span class="badge badge-warning">stale</span>
            #end if
            <span class="ml-2 text-white-50" data-snapshot-age="$cam.key">
              #if $cam.exists
              updated $cam.age_minutes min ago
              #else
              no image
              #end if
            </span>
          </div>
        </div>
      </div>
      #end for
    </div>

    ## Clear Sky Chart (refreshed by the external pipeline inside cam_dir)
    #if $aurora.clearsky_chart.exists
    <div class="row my-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title $Extras.color-text">$Extras.Translations[$Extras.language].clear_sky_chart</h5>
            <img src="$aurora.clearsky_chart.url?v=$aurora.clearsky_chart.mtime"
                 class="aurora-clearsky-img aurora-modal-trigger"
                 alt="$Extras.Translations[$Extras.language].clear_sky_chart"
                 loading="lazy" data-type="image"
                 data-src="$aurora.clearsky_chart.url?v=$aurora.clearsky_chart.mtime"
                 data-title="$Extras.Translations[$Extras.language].clear_sky_chart &mdash; full size">
            <div class="small text-muted mt-1">
              updated $aurora.clearsky_chart.age_minutes min ago &middot;
              <a href="https://www.cleardarksky.com/" target="_blank" rel="noopener">cleardarksky.com</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    #end if

    ## Activity cards
    <div class="row my-4">
      <div class="col-6 col-md-3 mb-3">
        <div class="card h-100 text-center">
          <div class="card-body">
            <div class="display-4" id="kp-now">&mdash;</div>
            <div class="text-muted">Kp index</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card h-100 text-center">
          <div class="card-body d-flex flex-column justify-content-center">
            <div class="py-2"><span class="badge aurora-badge" id="aurora-badge">&hellip;</span></div>
            <div class="text-muted">Activity</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card h-100 text-center">
          <div class="card-body">
            <div class="display-4" id="bz-now">&mdash;</div>
            <div class="text-muted">Bz (nT)</div>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3">
        <div class="card h-100 text-center">
          <div class="card-body">
            <div class="display-4" id="wind-now">&mdash;</div>
            <div class="text-muted">Solar wind (km/s)</div>
          </div>
        </div>
      </div>
    </div>

    ## Viewing conditions + Kp chart
    <div class="row my-4">
      <div class="col-12 col-lg-6 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Viewing conditions</h5>
            <table class="table table-sm mb-0">
              ## Omit rows for obs types the station does not report
              #if $current.outTemp.has_data
              <tr><td>Temperature</td><td class="text-right">$current.outTemp</td></tr>
              #end if
              #if $current.outHumidity.has_data
              <tr><td>Humidity</td><td class="text-right">$current.outHumidity</td></tr>
              #end if
              #if $current.windSpeed.has_data
              <tr><td>Wind</td><td class="text-right">$current.windSpeed
                #if $current.windDir.has_data
                $current.windDir.ordinal_compass
                #end if
              </td></tr>
              #end if
              <tr><td>Moon</td><td class="text-right">$almanac.moon_phase ($almanac.moon_fullness%)</td></tr>
              #if $almanac.hasExtras
              <tr><td>Astro dusk</td><td class="text-right">$almanac(horizon=-18).sun.set</td></tr>
              <tr><td>Astro dawn</td><td class="text-right">$almanac(horizon=-18).sun.rise</td></tr>
              #end if
            </table>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Kp index, last 24 hours</h5>
            <div id="kp-chart"></div>
          </div>
        </div>
      </div>
    </div>

    ## Pipeline status + links
    <div class="row mb-4">
      <div class="col-12">
        <div class="card">
          <div class="card-body d-flex flex-wrap align-items-center">
            <div class="mr-auto">
              <span class="text-muted mr-2">Archive status:</span>
              #if $aurora.status == 'ok'
              <span class="badge badge-success">up to date</span>
              #elif $aurora.status == 'stale'
              <span class="badge badge-warning">stale data</span>
              #elif $aurora.status == 'encoding'
              <span class="badge badge-info">tonight's timelapse still encoding</span>
              #else
              <span class="badge badge-secondary">no data</span>
              #end if
            </div>
            <a class="btn btn-$Extras.color btn-sm mr-2" href="gallery.html">Timelapse gallery</a>
            <a class="btn btn-$Extras.color btn-sm" href="solar.html">Solar activity</a>
          </div>
        </div>
      </div>
    </div>

  #end if

  </div>
</main>

<div id="auroraModal" class="aurora-modal" aria-hidden="true" role="dialog"
     aria-label="Media viewer">
  <span class="aurora-modal-close" aria-label="Close">&times;</span>
  <figure class="aurora-modal-dialog">
    <div class="aurora-modal-body"></div>
    <figcaption class="aurora-modal-caption"></figcaption>
  </figure>
</div>

#include "footer.inc"
#include "js.inc"
#if $aurora.enabled
<script src="js/modules/aurora.js?v=$aurora.asset_version"></script>
<script src="js/aurora-gallery.js?v=$aurora.asset_version"></script>
#end if

</body>
</html>
